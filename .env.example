# Copy to .env and fill in. .env is git-ignored and must never be committed.

# ---- Alchemy ----
# One API key covers all enabled networks (Ethereum, Base, Arbitrum).
# Dashboard: https://dashboard.alchemy.com
# Free tier: 300M compute units/month
ALCHEMY_API_KEY=your_alchemy_api_key_here

# ---- CoinGecko (optional fallback for prices) ----
# Free tier available at https://www.coingecko.com/en/api
# Only needed for tokens missing from Dune's price tables.
COINGECKO_API_KEY=

# ---- Local paths (optional overrides) ----
# ALPHAWALLETS_DATA_DIR=./data
# ALPHAWALLETS_CACHE_DB=./data/cache.duckdb
